          "request": {
            "name": "Tableau Query Schedules",
            "description": {
              "content": "Returns a list of extract refresh and subscription schedules. This method is available on Tableau Server only.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "schedules"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "100",
                  "description": "The number of items to return in one response. The minimum is 1 and the maximum is 1000."
                },
                {
                  "disabled": false,
                  "key": "pageNumber",
                  "value": "1",
                  "description": "The page number of the set of items to return. The default is 1."
                }
              ],
              "variable": [
                {
                  "description": "The hostname of your Tableau Server or Tableau Cloud site. For Tableau Cloud, use the pod URL (e.g., 10ax.online.tableau.com). For Tableau Server, use your server hostname.",
                  "type": "any",
                  "value": "{{server}}",
                  "key": "server"
                },
                {
                  "description": "The version of the REST API to use. The API version corresponds to the version of Tableau Server or Tableau Cloud. (This can only be one of 3.24,3.23,3.22,3.21,3.20,3.19)",
                  "type": "any",
                  "value": "{{api-version}}",
                  "key": "api-version"
                }
              ]
            },
