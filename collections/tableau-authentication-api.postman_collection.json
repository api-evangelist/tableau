{
  "item": [
    {
      "id": "d0a509bf-1544-41c8-99b8-bf655d5f34f7",
      "name": "Authentication",
      "description": {
        "content": "Sign in and sign out of Tableau Server or Tableau Cloud. You must sign in to obtain an authentication token before calling other methods.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3bbe8403-c097-4328-8415-852aed3da350",
          "name": "Tableau Sign in",
          "request": {
            "name": "Tableau Sign in",
            "description": {
              "content": "Signs you in as a user on the specified site on Tableau Server or Tableau Cloud. This call returns an authentication token that you use in subsequent calls to the server. Typically, a credentials token is valid for 240 minutes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "signin"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The hostname of your Tableau Server or Tableau Cloud site. For Tableau Cloud, use the pod URL (e.g., 10ax.online.tableau.com). For Tableau Server, use your server hostname.",
                  "type": "any",
                  "value": "{{server}}",
                  "key": "server"
                },
                {
                  "description": "The version of the REST API to use. The API version corresponds to the version of Tableau Server or Tableau Cloud. (This can only be one of 3.24,3.23,3.22,3.21,3.20,3.19)",
                  "type": "any",
                  "value": "{{api-version}}",
                  "key": "api-version"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credentials\": {\n    \"site\": {\n      \"contentUrl\": \"<string>\"\n    },\n    \"name\": \"<string>\",\n    \"password\": \"<password>\",\n    \"personalAccessTokenName\": \"<string>\",\n    \"personalAccessTokenSecret\": \"<password>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "9f3101b3-a1c3-4966-a96a-4e9d094b83e3",
              "name": "Successfully signed in.",
              "originalRequest": {
                "url": {
                  "path": [
                    "auth",
                    "signin"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "The hostname of your Tableau Server or Tableau Cloud site. For Tableau Cloud, use the pod URL (e.g., 10ax.online.tableau.com). For Tableau Server, use your server hostname.",
                      "type": "any",
                      "value": "{{server}}",
                      "key": "server"
                    },
                    {
                      "description": "The version of the REST API to use. The API version corresponds to the version of Tableau Server or Tableau Cloud. (This can only be one of 3.24,3.23,3.22,3.21,3.20,3.19)",
                      "type": "any",
                      "value": "{{api-version}}",
                      "key": "api-version"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "X-Tableau-Auth",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"credentials\": {\n    \"name\": \"Example Title\",\n    \"password\": \"example_value\",\n    \"personalAccessTokenName\": \"example_value\",\n    \"personalAccessTokenSecret\": \"example_value\",\n    \"site\": {\n      \"contentUrl\": \"https://www.example.com\"\n    }\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"credentials\": {\n    \"token\": \"example_value\",\n    \"site\": {\n      \"id\": \"abc123\",\n      \"contentUrl\": \"https://www.example.com\"\n    },\n    \"user\": {\n      \"id\": \"abc123\"\n    }\n  }\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
