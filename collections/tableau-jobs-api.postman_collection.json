          "request": {
            "name": "Tableau Query Jobs",
            "description": {
              "content": "Returns a list of active jobs on the specified site.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sites",
                ":site-id",
                "jobs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "100",
                  "description": "The number of items to return in one response. The minimum is 1 and the maximum is 1000."
                },
                {
                  "disabled": false,
                  "key": "pageNumber",
                  "value": "1",
                  "description": "The page number of the set of items to return. The default is 1."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "An expression that lets you specify a subset of items to return. Use the format filter=field:operator:value. Operators include eq, gt, gte, lt, lte, has, and in."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "site-id",
                  "description": "(Required) The ID of the site. You can get the site ID from the response to the Sign In method."
                },
                {
                  "description": "The hostname of your Tableau Server or Tableau Cloud site. For Tableau Cloud, use the pod URL (e.g., 10ax.online.tableau.com). For Tableau Server, use your server hostname.",
                  "type": "any",
                  "value": "{{server}}",
                  "key": "server"
                },
                {
                  "description": "The version of the REST API to use. The API version corresponds to the version of Tableau Server or Tableau Cloud. (This can only be one of 3.24,3.23,3.22,3.21,3.20,3.19)",
                  "type": "any",
                  "value": "{{api-version}}",
                  "key": "api-version"
