        {
          "id": "c372e6ec-82ab-4923-a09a-4c54a833b95b",
          "name": "Tableau Switch Site",
          "request": {
            "name": "Tableau Switch Site",
            "description": {
              "content": "Switches you to the specified site without having to provide a user name and password again. The new site must be on the same server.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "switchSite"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The hostname of your Tableau Server or Tableau Cloud site. For Tableau Cloud, use the pod URL (e.g., 10ax.online.tableau.com). For Tableau Server, use your server hostname.",
                  "type": "any",
                  "value": "{{server}}",
                  "key": "server"
                },
                {
                  "description": "The version of the REST API to use. The API version corresponds to the version of Tableau Server or Tableau Cloud. (This can only be one of 3.24,3.23,3.22,3.21,3.20,3.19)",
                  "type": "any",
                  "value": "{{api-version}}",
                  "key": "api-version"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"site\": {\n    \"contentUrl\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "b4c0e33a-5102-4528-a04b-d190a841b870",
              "name": "Successfully switched to the specified site.",
              "originalRequest": {
                "url": {
                  "path": [
                    "auth",
                    "switchSite"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "The hostname of your Tableau Server or Tableau Cloud site. For Tableau Cloud, use the pod URL (e.g., 10ax.online.tableau.com). For Tableau Server, use your server hostname.",
