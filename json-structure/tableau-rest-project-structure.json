{
  "$schema": "https://json-structure.org/draft/2020-12/schema",
  "name": "Project",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "parentProjectId": {
      "type": "['string', 'null']"
    },
    "contentPermissions": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "owner": {
      "type": "object"
    },
    "topLevelProject": {
      "type": "boolean"
    }
  }
}