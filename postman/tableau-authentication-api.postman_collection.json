          "item": [
            {
              "name": "Tableau Sign in",
              "id": "9bdfa37f-bcc6-4c4d-88bd-e2cafc608d07",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"credentials\": {\n    \"site\": {\n      \"contentUrl\": \"<string>\"\n    },\n    \"name\": \"<string>\",\n    \"password\": \"<string>\",\n    \"personalAccessTokenName\": \"<string>\",\n    \"personalAccessTokenSecret\": \"<string>\"\n  }\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/auth/signin",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "signin"
                  ]
                },
                "description": "Signs you in as a user on the specified site on Tableau Server or Tableau Cloud. This call returns an authentication token that you use in subsequent calls to the server. Typically, a credentials token is valid for 240 minutes."
              },
              "response": [
                {
                  "id": "dda82bd0-f8b0-4e09-b510-66614f6f498d",
                  "name": "Successfully signed in.",
