        "minimumSiteRole": {
          "type": "string",
          "enum": [
            "Creator",
            "Explorer",
            "ExplorerCanPublish",
            "SiteAdministratorCreator",
            "SiteAdministratorExplorer",
            "Unlicensed",
            "Viewer"
          ]
        }
      },
      "example": "example_value"
    }
  }
}