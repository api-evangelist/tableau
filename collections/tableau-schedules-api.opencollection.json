{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tableau REST Authentication Schedules API",
    "version": "3.24.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Tableau-Auth",
      "value": "{{X-Tableau-Auth}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Schedules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Tableau Query Schedules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}/api/{api-version}/schedules",
            "params": [
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "The number of items to return in one response. The minimum is 1 and the maximum is 1000."
              },
              {
                "name": "pageNumber",
                "value": "",
                "type": "query",
                "description": "The page number of the set of items to return. The default is 1."
              }
            ]
          },
          "docs": "Returns a list of extract refresh and subscription schedules. This method is available on Tableau Server only."
        }
      ]
    }
  ],
  "bundled": true
}